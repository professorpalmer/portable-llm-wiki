# Portable LLM Wiki — backend config
# Copy to .env and fill in. `scripts/init.sh` writes most of this for you
# on first run; this file documents every var the backend reads.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Absolute path to wiki root. Must contain a "wiki/" subfolder with markdown
# pages. Optional sibling "raw/" subfolder for immutable source files.
# For the bundled demo, set this to the repo's wiki-demo/ directory.
WIKI_ROOT=/Users/me/my-wiki

# Owner bearer token. Every /owner/* endpoint and every mutating POST
# requires `Authorization: Bearer <OWNER_TOKEN>`. Generate one with:
#   openssl rand -hex 32
# On Render, `render.yaml` sets `generateValue: true` so this is auto-filled.
OWNER_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Tier model
# ---------------------------------------------------------------------------

# Default tier for pages that don't declare one in frontmatter.
# Safer default is "private" so nothing leaks by accident. The Render
# blueprint ships "public" so the hosted demo works out of the box —
# flip to "private" on your own deploy if you'd rather opt-in per page.
DEFAULT_TIER=private

# Optional share tokens (format: tokenA:recruiter,tokenB:friend).
# Anyone hitting the wiki with `Authorization: Bearer <tokenA>` sees the
# `recruiter` tier. Most owners mint share tokens from the /owner console
# instead of setting this env var by hand.
# SHARE_TOKENS=

# ---------------------------------------------------------------------------
# Query backend (optional — keyword fallback works without any keys)
# ---------------------------------------------------------------------------

# If set, /wiki/query and /wiki/chat use Anthropic. The model name below
# is tried FIRST; if the provider 404s (e.g. the model was deprecated)
# the backend cycles through ANTHROPIC_FALLBACK_CHAIN in backend/app/llm.py
# automatically — no redeploy needed.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# If set (and no Anthropic key), /wiki/query uses OpenAI instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# CORS + public URL
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed via CORS. The frontend dev
# server is included by default. For production, add your Vercel URL
# (and any custom domain) here.
#   e.g. https://wiki.example.com,https://my-wiki.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public-facing base URL used for QR code generation, OG metadata, and
# share-link URLs. Set to your LAN IP (or public tunnel URL) when
# sharing with phones / other LLMs. In production this should be your
# Vercel URL or custom domain.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting (public requests only — owner bypasses)
# ---------------------------------------------------------------------------

# Token-bucket limiter applied per client IP. Owner requests
# (Authorization: Bearer <OWNER_TOKEN>) bypass the bucket entirely.
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=20
# RATE_LIMIT_ENABLED=1

# ---------------------------------------------------------------------------
# Git-backed persistence (for production deploys on ephemeral filesystems)
# ---------------------------------------------------------------------------

# IMPORTANT: until WIKI_GIT_REMOTE is set, every write stays on local disk
# only — it will NOT survive a restart or reach any hosted site. This is
# never silent: each create/mutate API response carries a `sync` verdict,
# and the MCP + web UI show a loud "saved locally, not durable" warning so
# you always know. Set the remote below to turn on autopush.
#
# Render's free tier wipes the filesystem on cold-start. Point the wiki
# at a private GitHub repo and the backend will clone it on boot and
# debounce-push every mutation back to it. Setup:
#   1. Create an empty private repo, e.g. "my-wiki" on github.com.
#   2. Generate a PAT at https://github.com/settings/tokens?type=beta
#      with "Contents: read & write" scope, repo-scoped to that one repo.
#   3. Set WIKI_GIT_REMOTE to the clone URL with the PAT embedded:
# WIKI_GIT_REMOTE=https://USER:PAT@github.com/USER/my-wiki.git
# WIKI_GIT_BRANCH=main
# WIKI_GIT_USER_NAME=Portable LLM Wiki Bot
# WIKI_GIT_USER_EMAIL=wiki-bot@example.com
# WIKI_GIT_PUSH_DELAY_S=8
# WIKI_GIT_AUTOSYNC=1

# Hosted (multi-tenant) durability: auto-push each connected tenant's
# edits to its GitHub repo. Distinct from WIKI_GIT_AUTOSYNC above, which
# only governs the single-tenant global remote (and defaults OFF in hosted
# mode because there's no global WIKI_GIT_REMOTE). A connected tenant repo
# IS the user's durability guarantee, so this defaults ON. Set to 0 to make
# every tenant manual-sync-only (edits stay on the server until a manual
# "Sync now" from the owner console).
# WIKI_TENANT_AUTOPUSH=1

# Hosted (multi-tenant) drift killer: how often, in seconds, the
# background poller fast-forwards every connected tenant's hosted mirror
# from GitHub. This is what stops a hosted wiki from silently falling
# behind the owner's local authoring. Only SAFE fast-forwards happen —
# diverged/dirty tenants are left for the owner. Set to 0 to disable the
# poller (e.g. if you rely solely on the GitHub push webhook below).
# WIKI_TENANT_PULL_POLL_S=300

# ---------------------------------------------------------------------------
# Puppetmaster orchestration (optional — only if you want LLM-driven ingest)
# ---------------------------------------------------------------------------

# Path to the `puppetmaster` CLI used by /owner/ingest with
# run_orchestrator=true and by the semantic-lint swarm. Defaults to
# whatever `puppetmaster` resolves to on PATH.
# PUPPETMASTER_BIN=puppetmaster
# CURSOR_API_KEY=

# ---------------------------------------------------------------------------
# Hosted multi-tenant mode (portablellm.wiki only — leave unset for OSS)
# ---------------------------------------------------------------------------
#
# Set SINGLE_TENANT_MODE=0 to enable the hosted product. Every wiki then
# lives under TENANTS_ROOT/<tenant_id>/wiki/, accessed at /t/<tenant_id>/...
# on the API. The OSS self-host path (SINGLE_TENANT_MODE unset or 1) is
# byte-for-byte unchanged.
# SINGLE_TENANT_MODE=0

# Where per-tenant wikis live. Defaults to <WIKI_ROOT parent>/tenants.
# TENANTS_ROOT=/var/data/tenants

# Signed-cookie session secret. Required when SINGLE_TENANT_MODE=0.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=
# SESSION_COOKIE_NAME=plw_session

# Session cookie Domain attribute. Set this in production deploys where the
# API and the frontend are on different subdomains of the same registrable
# domain (e.g. api.example.com + example.com). Use a leading dot so the
# cookie is shared across subdomains:
#   SESSION_COOKIE_DOMAIN=.portablellm.wiki
# Leave unset for local dev (host-only cookie).
# SESSION_COOKIE_DOMAIN=

# GitHub OAuth App credentials (https://github.com/settings/applications/new).
# Authorization callback URL must match GITHUB_OAUTH_REDIRECT_URL exactly.
# The OAuth App needs `read:user, public_repo` scopes (we request them
# automatically; user sees the consent screen).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URL=https://api.portablellm.wiki/auth/github/callback
#
# Public origin of the API host, used to build the GitHub push-webhook
# callback (POST <PUBLIC_API_BASE_URL>/hooks/github). Registered per
# tenant at repo-connect time so local pushes propagate to the hosted
# mirror within seconds. Defaults to the origin of GITHUB_OAUTH_REDIRECT_URL
# (which is already on the API host), so you usually don't need to set it.
# PUBLIC_API_BASE_URL=https://api.portablellm.wiki
