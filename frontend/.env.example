# Portable LLM Wiki — frontend env vars.
#
# In Vercel: set these in the project's Environment Variables panel.
# Locally: copy to .env.local (which is gitignored).
#
# Only NEXT_PUBLIC_* vars are baked into the client bundle and visible to
# the browser. Everything is optional for local dev — sensible defaults
# kick in below.

# ---------------------------------------------------------------------------
# Backend URL
# ---------------------------------------------------------------------------

# Where the backend FastAPI service lives. The Next.js dev server proxies
# /api/backend/* to this URL (configured in next.config.mjs).
# Local development:  http://localhost:8000
# Vercel + Render:    https://<your-backend-service>.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Public-facing URL of this frontend
# ---------------------------------------------------------------------------

# Used for Open Graph metadataBase, QR codes, and outbound share links.
# Leave unset locally — defaults to http://localhost:3000.
# In production: https://your-app.vercel.app  (or your custom domain).
# NEXT_PUBLIC_SITE_URL=https://wiki.example.com

# Legacy / fallback alias for NEXT_PUBLIC_SITE_URL — the layout reads
# either. Set just one of them; NEXT_PUBLIC_SITE_URL is preferred.
# NEXT_PUBLIC_PUBLIC_BASE_URL=https://wiki.example.com
